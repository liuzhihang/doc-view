{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Doc View MCP tool contracts v1",
  "contractVersion": 1,
  "transport": "One MCP TextContent block containing the JSON described by resultContentSchema; not protocol structuredContent/outputSchema.",
  "diskSchemaSource": "../project-document-store/schemas/document-store.schema.json",
  "maintenance": "Copied store definitions must remain identical; validation checks equality.",
  "constraints": {
    "resultBytesMax": 4194304,
    "queryTermsMax": 16,
    "queryDeadlineSeconds": 5,
    "generateDeadlineSeconds": 120,
    "maxConcurrentReadsPerProject": 4,
    "maxConcurrentWritesPerProject": 1
  },
  "$defs": {
    "identity": {
      "type": "object",
      "properties": {
        "module": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "qualifiedClass": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "methodName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "parameterTypes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "maxItems": 255
        },
        "fullSignature": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "canonicalForm": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$",
          "maxLength": 65536
        }
      },
      "required": [
        "module",
        "qualifiedClass",
        "methodName",
        "parameterTypes",
        "fullSignature",
        "canonicalForm"
      ],
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*\\u0000)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*?/$).+$"
        },
        "line": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 2147483647
        },
        "capturedContentSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "basis": {
          "const": "ide-document-text"
        }
      },
      "required": [
        "path",
        "line",
        "capturedContentSha256",
        "basis"
      ],
      "additionalProperties": false
    },
    "file": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*\\u0000)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*?/$).+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false
    },
    "field": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 4096
