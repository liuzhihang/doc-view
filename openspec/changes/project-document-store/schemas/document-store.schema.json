{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Doc View project document store v1 (planned)",
  "$defs": {
    "identity": {
      "type": "object",
      "properties": {
        "module": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "qualifiedClass": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "methodName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "parameterTypes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "maxItems": 255
        },
        "fullSignature": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "canonicalForm": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$",
          "maxLength": 65536
        }
      },
      "required": [
        "module",
        "qualifiedClass",
        "methodName",
        "parameterTypes",
        "fullSignature",
        "canonicalForm"
      ],
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*\\u0000)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*?/$).+$"
        },
        "line": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 2147483647
        },
        "capturedContentSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "basis": {
          "const": "ide-document-text"
        }
      },
      "required": [
        "path",
        "line",
        "capturedContentSha256",
        "basis"
      ],
      "additionalProperties": false
    },
    "file": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*\\u0000)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*?/$).+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false
    },
    "field": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 4096
        },
        "type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "description": {
          "type": "string",
          "maxLength": 1048576
        },
        "required": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "example": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1048576
        },
        "since": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1048576
        },
        "version": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1048576
        },
        "isCollection": {
          "type": "boolean"
        },
        "isMap": {
          "type": "boolean"
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/field"
          },
          "maxItems": 10000
        }
      },
      "required": [
        "name",
        "type",
        "description",
        "required",
        "example",
        "since",
        "version",
        "isCollection",
        "isMap",
        "children"
      ],
      "additionalProperties": false
    },
    "header": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "description": {
          "type": "string",
          "maxLength": 1048576
        },
        "required": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "example": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1048576
        }
      },
      "required": [
        "name",
        "description",
        "required",
        "example"
      ],
      "additionalProperties": false
    },
    "body": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/field"
          },
          "maxItems": 10000
        }
      },
      "required": [
        "type",
        "fields"
      ],
      "additionalProperties": false
    },
    "integrity": {
      "type": "object",
      "properties": {
        "algorithm": {
          "const": "sha256-jcs"
        },
        "value": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "algorithm",
        "value"
      ],
      "additionalProperties": false
    },
    "entry": {
      "type": "object",
      "properties": {
        "apiId": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "identity": {
          "$ref": "#/$defs/identity"
        },
        "name": {
          "type": "string",
          "maxLength": 1048576
        },
        "description": {
          "type": "string",
          "maxLength": 1048576
        },
        "framework": {
          "enum": [
            "spring",
            "feign",
            "dubbo",
            "interface"
          ]
        },
        "httpMethod": {
          "enum": [
            null,
            "GET",
            "HEAD",
            "POST",
            "PUT",
            "DELETE",
            "CONNECT",
            "OPTIONS",
            "TRACE",
            "PATCH"
          ]
        },
        "httpPath": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1048576
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "maxItems": 1000
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "markdown": {
          "$ref": "#/$defs/file"
        },
        "detail": {
          "$ref": "#/$defs/file"
        }
      },
      "required": [
        "apiId",
        "identity",
        "name",
        "description",
        "framework",
        "httpMethod",
        "httpPath",
        "tags",
        "source",
        "markdown",
        "detail"
      ],
      "additionalProperties": false
    },
    "apiPayload": {
      "type": "object",
      "properties": {
        "apiId": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "identity": {
          "$ref": "#/$defs/identity"
        },
        "name": {
          "type": "string",
          "maxLength": 1048576
        },
        "description": {
          "type": "string",
          "maxLength": 1048576
        },
        "framework": {
          "enum": [
            "spring",
            "feign",
            "dubbo",
            "interface"
          ]
        },
        "httpMethod": {
          "enum": [
            null,
            "GET",
            "HEAD",
            "POST",
            "PUT",
            "DELETE",
            "CONNECT",
            "OPTIONS",
            "TRACE",
            "PATCH"
          ]
        },
        "httpPath": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1048576
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "maxItems": 1000
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "headers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/header"
          },
          "maxItems": 10000
        },
        "requestParameters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/field"
          },
          "maxItems": 10000
        },
        "requestBody": {
          "anyOf": [
            {
              "$ref": "#/$defs/body"
            },
            {
              "type": "null"
            }
          ]
        },
        "responseBody": {
          "anyOf": [
            {
              "$ref": "#/$defs/body"
            },
            {
              "type": "null"
            }
          ]
        },
        "examples": {
          "type": "object",
          "properties": {
            "request": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 1048576
            },
            "response": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 1048576
            }
          },
          "required": [
            "request",
            "response"
          ],
          "additionalProperties": false
        },
        "remark": {
          "type": "string",
          "maxLength": 1048576
        }
      },
      "required": [
        "apiId",
        "identity",
        "name",
        "description",
        "framework",
        "httpMethod",
        "httpPath",
        "tags",
        "source",
        "headers",
        "requestParameters",
        "requestBody",
        "responseBody",
        "examples",
        "remark"
      ],
      "additionalProperties": false
    },
    "indexPayload": {
      "type": "object",
      "properties": {
        "snapshotId": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "generatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "producerVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "generatorFingerprint": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "hasUnsavedDocuments": {
          "type": "boolean"
        },
        "markdownIndex": {
          "$ref": "#/$defs/file"
        },
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/entry"
          },
          "maxItems": 10000
        }
      },
      "required": [
        "snapshotId",
        "generatedAt",
        "producerVersion",
        "generatorFingerprint",
        "hasUnsavedDocuments",
        "markdownIndex",
        "entries"
      ],
      "additionalProperties": false
    },
    "index": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "owner": {
          "const": "com.liuzhihang.doc.view"
        },
        "kind": {
          "const": "index"
        },
        "payload": {
          "$ref": "#/$defs/indexPayload"
        },
        "integrity": {
          "$ref": "#/$defs/integrity"
        }
      },
      "required": [
        "schemaVersion",
        "owner",
        "kind",
        "payload",
        "integrity"
      ],
      "additionalProperties": false
    },
    "api": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "owner": {
          "const": "com.liuzhihang.doc.view"
        },
        "kind": {
          "const": "api"
        },
        "payload": {
          "$ref": "#/$defs/apiPayload"
        },
        "integrity": {
          "$ref": "#/$defs/integrity"
        }
      },
      "required": [
        "schemaVersion",
        "owner",
        "kind",
        "payload",
        "integrity"
      ],
      "additionalProperties": false
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/index"
    },
    {
      "$ref": "#/$defs/api"
    }
  ]
}
